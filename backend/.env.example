# Copy to backend/.env (never commit .env)
ENV=development
LOG_LEVEL=INFO

# PostgreSQL (psycopg2). Create the database first, see README.
DATABASE_URL=postgresql+psycopg2://supplywise:Simp01627@localhost:5432/supplywise

CORS_ORIGINS=http://localhost:5173

# Auth. Frontend has no login yet, so this is off by default (all requests act as a system admin).
AUTH_ENABLED=false
JWT_SECRET=                # required when AUTH_ENABLED=true; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=480

# Business rules
APPROVAL_THRESHOLD=100000  # INR; orders above this need a manager (matches ai/knowledge_base policy POL-001)
FORECAST_HORIZON_DAYS=14

# Forecasting: baseline | external (see README "ML integration")
FORECAST_PROVIDER=baseline
ML_PREDICT_CALLABLE=       # e.g. ml.inference:predict_demand  (only for FORECAST_PROVIDER=external)

# AI / RAG. GEMINI_API_KEY lives in the REPO ROOT .env (ai/rag/answer_generator.py reads it via load_dotenv)
AI_ENABLED=true
# CHROMA_PERSIST_DIRECTORY defaults to <repo root>/chroma_db, the same folder PolicyAnalystAgent uses
# CHROMA_PERSIST_DIRECTORY=
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10
