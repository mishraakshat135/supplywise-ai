# Copy to .env and edit
APP_NAME=SupplyWise AI
DEBUG=true

# --- Database ---
# SQLite for development; switch to PostgreSQL later:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/supplywise
DATABASE_URL=sqlite:///./supplywise.db
AUTO_CREATE_TABLES=true          # set false once you use Alembic migrations

# --- CORS (React dev servers) ---
# TODO(INTEGRATION: FRONTEND) add your deployed frontend URL here (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Procurement business rules ---
DEFAULT_COVERAGE_DAYS=14
DEFAULT_ORDER_BUDGET=100000
APPROVAL_THRESHOLD=50000         # orders above this amount get an "extra approval" flag
MIN_HISTORY_DAYS=30              # below this -> cold-start forecast

# --- ML ---
MODEL_DIR=./data/models
FORECAST_BACKEND=auto            # auto | moving_average | sklearn

# --- RAG ---
UPLOAD_DIR=./data/uploads
RETRIEVER_BACKEND=keyword        # keyword (no deps) | chroma
CHROMA_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM ---
LLM_BACKEND=template             # template (no API needed) | anthropic
LLM_MODEL=claude-sonnet-5-5      # check docs.claude.com for current model names
ANTHROPIC_API_KEY=
